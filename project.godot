; 網金游俠模擬器 — Godot 4.6.3+
config_version=5

[application]
config/name="網金游俠模擬器"
config/version="0.7.1"
run/main_scene="res://scenes/journey.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[autoload]
SteamBridge="*res://scripts/steam_bridge.gd"
Session="*res://scripts/session.gd"
Bgm="*res://scripts/bgm.gd"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/size/resizable=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.043, 0.055, 0.063, 1)

[steam]
initialization/app_data/app_id=480
initialization/processes/initialize_on_startup=false
initialization/processes/embed_callbacks=false
